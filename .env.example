# Pin upgrades deliberately. Check the Orca release notes before changing this.
ORCA_VERSION=v1.4.188

# Address clients dial. Replace this placeholder with a Tailscale IP, private
# hostname, or complete TLS reverse-proxy URL such as https://orca.example.com/runtime.
ORCA_PAIRING_ADDRESS=replace-with-reachable-address.invalid

# Keep loopback when a local reverse proxy or host-network Tailscale fronts Orca.
# Use a private interface address only when clients connect directly over a trusted network.
ORCA_BIND_ADDRESS=127.0.0.1
ORCA_PORT=6768
