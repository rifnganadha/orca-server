# Orca releases: https://github.com/stablyai/orca/releases
# Pin upgrades deliberately. Check the release notes before changing this.
ORCA_VERSION=v1.4.190

# Target platform for the Orca image. Choose linux/amd64 or linux/arm64.
DOCKER_PLATFORM=linux/amd64

# Build-time tool versions bundled into Orca.
NODE_VERSION=22.20.0
SKILLS_CLI_VERSION=1.5.23
KILO_CLI_VERSION=7.5.6

# Docker CLI bundled into Orca and group ID allowed to access docker.sock.
# Docker Desktop commonly uses GID 0. On Linux: stat -c '%g' /var/run/docker.sock
DOCKER_CLI_VERSION=29.1.3
DOCKER_GID=0

# Address clients dial. Choose one pattern and keep only one active value:
# Private LAN:       ORCA_PAIRING_ADDRESS=192.168.1.4
# Tailscale:         ORCA_PAIRING_ADDRESS=100.64.0.10
# TLS reverse proxy: ORCA_PAIRING_ADDRESS=https://orca.example.com
ORCA_PAIRING_ADDRESS=192.168.1.4

# Host port published to clients and appended to a bare ORCA_PAIRING_ADDRESS.
ORCA_PORT=6770

# Hostname displayed in Orca terminal prompts and tab titles.
ORCA_HOSTNAME=orca-server

# Basic Auth for browser HTTP requests. WebSocket pairing traffic keeps using
# Orca's pairing grants. Use a long, unique password and keep this file private.
ORCA_WEB_USER=orca
ORCA_WEB_PASSWORD=change-this-password

# Author identity used for commits created by Orca and its agents.
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com

# Optional non-interactive GitHub authentication. Use a fine-grained token and
# keep this file out of source control. Leave empty to use device login instead.
GH_TOKEN=

# Kilo custom provider. Defaults use an OpenAI-compatible 9Router endpoint.
# Change these values and recreate the container; no image rebuild is required.
KILO_PROVIDER_ID=9router
KILO_PROVIDER_NAME=9Router
KILO_PROVIDER_NPM=@ai-sdk/openai-compatible
KILO_BASE_URL=https://9router.example.com/v1
KILO_MODEL_ID=gpt-5.6-sol
KILO_MODEL_NAME=GPT-5.6 SOL
KILO_API_KEY=

# Local codebase indexing via Ollama and Qdrant.
OLLAMA_VERSION=0.33.1
OLLAMA_NUM_PARALLEL=4
QDRANT_VERSION=v1.19.0
KILO_INDEXING_OLLAMA_URL=http://ollama:11434
KILO_INDEXING_MODEL=qwen3-embedding:0.6b
KILO_INDEXING_QDRANT_URL=http://qdrant:6333
